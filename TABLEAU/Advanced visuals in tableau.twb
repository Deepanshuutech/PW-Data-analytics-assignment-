      <aliases enabled='yes' />
      <column caption='Admission Date' datatype='date' name='[AdmissionDate]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
      <column caption='Month' datatype='datetime' name='[Calculation_0723770939990016]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [AdmissionDate])' />
      </column>
      <column caption='Rank by TreatmentCost' datatype='integer' name='[Calculation_0723770941652993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(AVG([TreatmentCost]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Male count ' datatype='integer' name='[Calculation_0723770945572866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Gender]= &quot;Male&quot; THEN 1&#13;&#10;ELSE &#13;&#10;0 END' />
      </column>
      <column caption='Female count' datatype='integer' name='[Calculation_0723770946424835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Gender] = &quot;Female&quot; THEN 1 &#13;&#10;ELSE&#13;&#10;0 &#13;&#10;END' />
      </column>
      <column caption='Male count negative' datatype='integer' name='[Calculation_0723770946650116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([Calculation_0723770945572866])' />
      </column>
