      <aliases enabled='yes' />
      <column caption='Delivery Status' datatype='string' name='[Calculation_0930750558625798]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Delivery_Time_Min] &lt;= 30 THEN &quot;Fast&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='ORDER STATUS' datatype='string' name='[Calculation_0930750559039495]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss-Making&quot;&#13;&#10;ELSE &quot;Profitable&quot;&#13;&#10;END' />
      </column>
      <column caption='avg sales per city' datatype='real' name='[Calculation_0930750560878606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [City] : AVG([Sales]) }' />
      </column>
      <column caption='Avg product sales' datatype='real' name='[Calculation_0930750560976911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Product_Name] : AVG([Sales]) }' />
